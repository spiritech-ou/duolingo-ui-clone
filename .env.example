VITE_API_BASE_URL=/api
VITE_USE_MOCKS=false
# BASE_PATH=/duolingo-ui-clone/
# Build-time only (read by vite.config.ts, not a VITE_ variable, never reaches the client).
# Public base path; unset means "/". Must start and end with "/".
# `npm run build:pages` and `npm run preview:pages` set it themselves (GitHub Pages sub path).
